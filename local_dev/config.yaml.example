server:
  host: 0.0.0.0
  port: 8000
  debug: false
  api_docs: true

app:
  organization_name: "Example Ltd."
  default_country_code: "HK"
  max_upload_mb: 30
  data_source_poll_minutes: 1
  # Allow data source links to point at LAN/internal addresses (link-local stays blocked).
  allow_private_data_sources: false

auth:
  admin_username: "NeverGonnaGiveYouUp"
  admin_password: "NeverGonnaLetYouDown"
  cookie_secure: false
  session_idle_days: 30
  session_absolute_days: 90
  login_rate_limit:
    enabled: true
    max_failures: 10
    window_seconds: 900
    # IP or CIDR of a reverse proxy that terminates TLS (nginx, Caddy, Traefik...)
    # so login rate limiting can identify real clients. Never 0.0.0.0/0.
    # This dev setup runs Caddy on the Docker "dev" network (172.31.210.0/24).
    trusted_proxies: ["172.31.210.0/24"]

# Email sending functionalities are not available in hot-reload dev server
email_smtp:
  host: "smtp.example.com"
  port: 420
  username: "noreply@example.com"
  password: "<not-a-password>"
  from_address: chriswong@example.com
  email_footer_enabled: true
  wait_between_delivery_second: 5